{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure local tests",
            "type": "shell",
            "command": "cmake --preset windows-msvc-tests",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: build local tests",
            "type": "shell",
            "command": "cmake --build --preset windows-msvc-tests-debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "CMake: test local",
            "type": "shell",
            "command": "ctest --preset windows-msvc-tests-debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Run local logger web",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"cmake --build --preset windows-msvc-tests-debug --target test_logger_web; if ($LASTEXITCODE -eq 0) { & '${workspaceFolder}\\out\\build\\windows-msvc-tests\\Debug\\test_logger_web.exe' '${workspaceFolder}\\house_notify.log' 8080 --open }\"",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "Remote build",
            "problemMatcher": [
                "$gcc"
            ],
            "type": "shell",
            "command": "ssh -tt chris@192.168.50.190 'cd ~/Desktop/HouseTempNotification && make build'"
        },
        {
            "label": "Remote run",
            "problemMatcher": [
                "$gcc"
            ],
            "type": "shell",
            "command": "ssh -tt chris@192.168.50.190 'cd ~/Desktop/HouseTempNotification && make run'"
        },
        {
            "label": "Remote kill notifier",
            "type": "shell",
            "command": "ssh chris@192.168.50.190 'cd ~/Desktop/HouseTempNotification && make kill'",
            "problemMatcher": []
        }
    ]
}
